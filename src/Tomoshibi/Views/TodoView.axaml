<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tomoshibi.ViewModels"
             xmlns:conv="using:Tomoshibi.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Tomoshibi.Views.TodoView"
             x:DataType="vm:TodoViewModel">

    <Grid>

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,4,28,28" MaxWidth="{StaticResource PageMaxWidth}">

        <!-- Page header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="3">
                <TextBlock Classes="path" Text="~/tomoshibi/todo" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="❯" Classes="prompt" />
                    <TextBlock Text="やること · backlog" Classes="h1 cjk" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="caption">
                    <Run Text="{Binding OpenCount, Mode=OneWay}" />
                    <Run Text=" backlog · " />
                    <Run Text="{Binding DoingCount, Mode=OneWay}" />
                    <Run Text=" doing · " />
                    <Run Text="{Binding DoneCount, Mode=OneWay}" />
                    <Run Text=" shipped" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1" Classes="accent" Content="+ new"
                    VerticalAlignment="Top"
                    Command="{Binding OpenAddCommand}" />
        </Grid>

        <!-- Filter bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,16,*" Margin="0,0,0,12">
            <Button Grid.Column="0" Classes="seg" Content="open"
                    Classes.active="{Binding IsOpenFilter}"
                    Command="{Binding ShowOpenCommand}" />
            <Button Grid.Column="1" Classes="seg" Content="done"
                    Classes.active="{Binding IsDoneFilter}"
                    Command="{Binding ShowDoneCommand}" />
            <Button Grid.Column="2" Classes="seg" Content="all"
                    Classes.active="{Binding IsAllFilter}"
                    Command="{Binding ShowAllCommand}" />

            <TextBox Grid.Column="4" Text="{Binding SearchText}"
                     Watermark="search title, notes, course…" />
        </Grid>

        <!-- Tickets -->
        <Border Grid.Row="2" Classes="card">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasVisibleItems}">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodoItemViewModel">
                                <StackPanel Margin="0,2,0,2">

                                    <!-- Row line -->
                                    <Border Classes="trow">
                                    <!-- Two lines, not twelve columns. Title, number
                                         and the actions on the first; everything that
                                         describes the ticket — due, priority, progress,
                                         effort, repeat, course — on a quieter second one.
                                         Cramming it into one line squeezed the title
                                         until it broke mid-word, and the metadata read
                                         as noise around it. Same shape the subjects page
                                         moved to in v2.1.1. -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                          RowDefinitions="Auto,Auto">
                                        <!-- ▸ and ○ have different metrics, so matching
                                             font sizes isn't enough to line them up. Equal
                                             square boxes with the glyph centred in each is
                                             what actually makes them agree. -->
                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="icon"
                                                AutomationProperties.Name="show / hide details"
                                                Content="{Binding ChevronGlyph}"
                                                Width="26" Height="26" Padding="0" FontSize="12"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding ToggleExpandedCommand}"
                                                ToolTip.Tip="show / hide details" />
                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="icon status"
                                                AutomationProperties.Name="{Binding StatusTip}"
                                                Classes.doing="{Binding IsDoing}"
                                                Classes.donestat="{Binding IsDone}"
                                                Content="{Binding StatusGlyph}"
                                                Width="26" Height="26" Padding="0" FontSize="14"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding CycleStatusCommand}"
                                                ToolTip.Tip="{Binding StatusTip}" />
                                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="{Binding NumberLabel}"
                                                   Classes="caption" VerticalAlignment="Center"
                                                   MinWidth="32" Margin="2,0,8,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Title}"
                                                   Classes.done="{Binding IsDone}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />

                                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="4" VerticalAlignment="Center">
                                            <Button Content="→ today" Classes="seg"
                                                    AutomationProperties.Name="send to today"
                                                    ToolTip.Tip="put this on today's plan"
                                                    Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).SendToTodayCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="edit" Classes="seg"
                                                    AutomationProperties.Name="edit this ticket"
                                                    ToolTip.Tip="edit this ticket"
                                                    Click="OnEditClick" />
                                            <Button Content="✕" Classes="icon"
                                                    AutomationProperties.Name="delete this ticket"
                                                    Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- The describing line -->
                                        <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="10"
                                                    Margin="0,3,0,0">
                                            <TextBlock Text="{Binding DueLabel}" Classes="caption"
                                                       Classes.overdue="{Binding IsOverdue}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding HasDue}" />
                                            <Border Classes="tag prio"
                                                    Classes.high="{Binding IsHighPriority}"
                                                    IsVisible="{Binding HasPriorityChip}">
                                                <TextBlock Text="{Binding PriorityLabel}" />
                                            </Border>
                                            <TextBlock Text="{Binding SubtaskProgress}" Classes="caption"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="checklist steps done"
                                                       IsVisible="{Binding HasSubtasks}" />
                                            <TextBlock Text="{Binding EffortLabel}" Classes="caption"
                                                       Classes.overest="{Binding IsOverEstimate}"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="focus blocks spent / estimated"
                                                       IsVisible="{Binding HasEffort}" />
                                            <TextBlock Text="{Binding RepeatLabel}" Classes="caption"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="the next one appears when this is done"
                                                       IsVisible="{Binding Repeats}" />
                                            <Border Classes="tag" IsVisible="{Binding HasCourse}">
                                                <TextBlock Text="{Binding Course}"
                                                           Foreground="{Binding Course, Converter={StaticResource CourseColor}}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    </Border>

                                    <!-- Expanded details -->
                                    <Border IsVisible="{Binding IsExpanded}"
                                            Margin="26,4,0,6" Padding="12,10"
                                            Background="{DynamicResource InkBrush}"
                                            CornerRadius="6">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap" FontSize="13"
                                                       IsVisible="{Binding HasDescription}" />

                                            <!-- Subtasks -->
                                            <ItemsControl ItemsSource="{Binding Subtasks}"
                                                          IsVisible="{Binding HasSubtasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SubtaskViewModel">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}"
                                                                      MinHeight="0" Padding="0"
                                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                       Classes.done="{Binding IsDone}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Grid.Column="2" Content="✕" Classes="icon"
                                                                    AutomationProperties.Name="remove this step"
                                                                    FontSize="11" Padding="4,2"
                                                                    Command="{Binding $parent[ItemsControl].((vm:TodoItemViewModel)DataContext).RemoveSubtaskCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add subtask -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding NewSubtaskTitle}"
                                                         Watermark="add a step…"
                                                         FontSize="13" Padding="10,6"
                                                         Classes.invalid="{Binding IsNewSubtaskInvalid}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddSubtaskCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="1" Content="+" Classes="icon"
                                                        AutomationProperties.Name="add step" Margin="4,0,0,0"
                                                        Command="{Binding AddSubtaskCommand}" />
                                            </Grid>

                                            <TextBlock Text="{Binding MetaLabel}" Classes="caption" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="何もない · nothing here"
                           Classes="jp" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasVisibleItems}" />
            </Grid>
        </Border>
    </Grid>

    </Grid>
</UserControl>
