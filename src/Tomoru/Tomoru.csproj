<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One flavour per build OS: Windows builds target the Windows TFM so
         toast notifications get the WinRT projections; macOS/Linux stay on
         plain net8.0. Each platform packs its own build (see scripts/), so
         don't cross-publish a Windows-built output to mac/linux or back. -->
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Keep in step with ReleaseNotes.Version — stamps the EXE metadata. -->
    <Version>2.3.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Dev tooling: the F12 inspector, Debug only. Avalonia.Diagnostics
         stopped at 11.3.20 and never shipped a 12.x; DiagnosticsSupport is
         what replaced it. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Read Anki's SQLite collection for .apkg import (bundles native e_sqlite3). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Material Design Icons (vector, theme-aware) for deck icons etc. -->
    <!-- Tracks the Avalonia major: 2.x is built against Avalonia 11 and 3.x
         against 12. A mismatch here doesn't fail the build — the icons ship
         compiled XAML, so it surfaces at runtime as a MissingMethodException
         on TemplateBinding.ProvideValue the first time a template is built. -->
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <!-- Embedded audio + video for flashcards (and a real Windows music
         backend). LibVLCSharp is the managed binding; the native libvlc comes
         from the per-OS packages below. -->
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <!-- The Tmds.DBus.Protocol pin is gone: it existed to force the patched
         0.21.3 over the vulnerable 0.20.0 that Avalonia 11 pulled in
         (GHSA-xrw6-gwf8-vvr9, High). Avalonia 12 depends on 0.94.1, which is
         well past that fix, so pinning now only holds it back. -->
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <!-- Toast notifications for unpackaged Win32 apps: registers the app
         identity on first use so toasts attribute to Tomoru. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <!-- Native libvlc, per OS. Linux uses the system libvlc (documented), so no
       native package there — the media service degrades gracefully if it's
       missing. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- chime.wav is excluded from embedding: the sound service plays it via
         the OS player, which needs a real file on disk next to the binary. -->
    <AvaloniaResource Include="Assets/**" Exclude="Assets/chime.wav" />
    <Content Include="Assets/chime.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
